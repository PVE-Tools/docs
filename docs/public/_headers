# 带 hash 的构建产物 - 长缓存 immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 页面 - 每次重新验证
/*
  Cache-Control: public, max-age=0, must-revalidate

# Logo 与图标 - 1 小时缓存
/pve-logo*.svg
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=3600

/sponsor/*
  Cache-Control: public, max-age=3600

# 入口脚本与版本信息 - 短缓存
/PVE-Tools.sh
  Cache-Control: public, max-age=600

/VERSION
  Cache-Control: public, max-age=600

/UPDATE
  Cache-Control: public, max-age=600
